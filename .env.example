# eBay Developer Credentials
# Get these from: https://developer.ebay.com → Your Account → Application Keys

EBAY_APP_ID=YourAppID-here
EBAY_DEV_ID=YourDevID-here
EBAY_CERT_ID=YourCertID-here

# User Token (Auth'n'Auth)
# Get this from: developer.ebay.com → Get a User Token
# Click "Get a User Token", sign in with your BUYER eBay account,
# and paste the token below. It expires in ~18 months.
EBAY_USER_TOKEN=AgAAAA**AQAAAA**...paste-full-token-here

# Server port (optional, default 3000)
PORT=3000
