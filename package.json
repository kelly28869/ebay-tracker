{
  "name": "ebay-snipe",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "build": "cd client && npm install && npm run build",
    "dev:server": "node --watch server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "axios": "^1.13.5",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "pg": "^8.18.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
